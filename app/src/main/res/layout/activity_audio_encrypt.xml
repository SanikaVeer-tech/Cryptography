<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pic"
    tools:context=".AudioEncryptActivity">

    <!-- Button to select the first audio (Primary audio) -->
    <Button
        android:id="@+id/btnSelectAudio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Audio"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp" />

    <!-- EditText for the user to enter the hidden message -->
    <EditText
        android:id="@+id/editTextMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Enter Message"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/btnSelectAudio"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp" />

    <!-- Button to select another audio to hide the message behind -->
    <Button
        android:id="@+id/btnSelectAnotherAudio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Another Audio to hide"
        app:layout_constraintTop_toBottomOf="@id/editTextMessage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp" />

    <!-- Button to trigger the encryption -->
    <Button
        android:id="@+id/btnEncrypt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Encrypt"
        app:layout_constraintTop_toBottomOf="@id/btnSelectAnotherAudio"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp" />

    <!-- TextView to display the encrypted key (Initially hidden) -->
    <TextView
        android:id="@+id/textViewEncryptedKey"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Encrypted Key:"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/btnEncrypt"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp" />

    <!-- Button to share the encrypted key -->
    <Button
        android:id="@+id/btnShare"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Share Key"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/textViewEncryptedKey"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Button to save the encrypted audio file -->
    <Button
        android:id="@+id/btnSave"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Save Encrypted Audio"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnShare" />

</androidx.constraintlayout.widget.ConstraintLayout>
